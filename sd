local function doWax(c)
    local key = c.Wax.Type
    if not VALID_WAX[key] then log("Воск: неизвестный тип", tostring(key)) return end

    local list = getBeesWithBeequips()
    local nBees = toAmount(c.Wax.Bees, #list)
    local times = toAmount(c.Wax.Times, 999)
    if nBees <= 0 or times <= 0 then return end
    if eggCountOf(key) <= 0 then log("Воск: нет предмета", key) return end

    local used = 0
    for i = 1, nBees do
        if eggCountOf(key) <= 0 then break end
        used += waxBee(list[i].x, list[i].y, key, times, c.Wax.Turpentine)
    end
    log(string.format("Воск %s: использовано %d", key, used))
end

----------------------------------------------------------------
-- Блендер
----------------------------------------------------------------
local RECIPE_NAMES = {
    "RedExtract", "BlueExtract", "Enzymes", "Oil", "Glue", "TropicalDrink", "Gumdrops",
    "MoonCharm", "Glitter", "StarJelly", "PurplePotion", "SoftWax", "HardWax", "SwirledWax",
    "CausticWax", "FieldDice", "SmoothDice", "LoadedDice", "SuperSmoothie", "Turpentine",
}
local AUTO_WAX = {SoftWax = true, HardWax = true} -- безопасно применять автоматически
local MAX_DEPTH = 6

local valueCache = {}
local function recipeValue(name)
    if valueCache[name] ~= nil then return valueCache[name] end
    valueCache[name] = 0
    local r = BlenderRecipes.Get(name)
    local v = 0
    if r then
        for _, ing in ipairs(r.Ingredients) do
            local unit = BlenderRecipes.Get(ing.Type) and recipeValue(ing.Type) or 1
            v += ing.Amount * unit
        end
    end
    valueCache[name] = v
    return v
end

local function reqsMet(r)
    if not r.Requirements or #r.Requirements == 0 then return true end
    if not ClientStatTools then return true end
    local ok, res = pcall(ClientStatTools.CheckReqs, r.Requirements)
    if ok then return res and true or false end
    return true -- не смогли проверить: решит сервер
end

-- Раскрывает рецепт: списывает ингредиенты из inv, недостающие докрафчивает.
-- steps получает шаги в порядке выполнения. Возвращает число тикетов или nil.
local function expand(name, count, inv, steps, depth)
    if depth > MAX_DEPTH then return nil end
    local r = BlenderRecipes.Get(name)
    if not r or not reqsMet(r) then return nil end

    local tickets = 0
    for _, ing in ipairs(r.Ingredients) do
        local need = ing.Amount * count
        local have = inv[ing.Type] or 0
        if have >= need then
            inv[ing.Type] = have - need
        else
            local short = need - have
            inv[ing.Type] = 0
            if not BlenderRecipes.Get(ing.Type) then return nil end -- базовый ресурс
            local t = expand(ing.Type, short, inv, steps, depth + 1)
            if not t then return nil end
            tickets += t
        end
    end

    local per = r.AutoCompletePerTicket or 1
    table.insert(steps, {name = name, count = count})
    return tickets + math.ceil(count / per)
end

local function tryBuild(eggs, name, n)
    local inv = {}
    for k, v in pairs(eggs) do inv[k] = v end
    local steps = {}
    local t = expand(name, n, inv, steps, 0)
    return t, steps
end

-- максимум штук рецепта, укладывающийся в ресурсы и в avail тикетов
local function bestCount(eggs, name, avail)
    local function ok(n)
        local t = tryBuild(eggs, name, n)
        return t ~= nil and t <= avail
    end
    if not ok(1) then return 0 end
    local lo, hi = 1, 2
    while ok(hi) do
        lo = hi
        hi = hi * 2
        if hi > 1e8 then return lo end
    end
    while hi - lo > 1 do
        local mid = math.floor((lo + hi) / 2)
        if ok(mid) then lo = mid else hi = mid end
    end
    return lo
end

local function makePlan(buyCap, priority)
    local stats = ClientStatCache:Get()
    if not stats then return nil, "Нет данных" end
    local eggs = stats.Eggs or {}
    local tickets = eggs.Ticket or 0
    local honey = stats.Honey or 0
    local bought = getTicketPurchases()
    buyCap = math.max(0, buyCap or 0)

    local rank = {}
    for i, n in ipairs(priority) do rank[n] = i end

    local buyable = buyCap > 0 and affordableTickets(honey, bought, buyCap) or 0
    local avail = tickets + buyable

    local names = {}
    for _, name in ipairs(RECIPE_NAMES) do
        local r = BlenderRecipes.Get(name)
        if r and reqsMet(r) then table.insert(names, name) end
    end
    table.sort(names, function(a, b)
        local ra, rb = rank[a] or 100, rank[b] or 100
        if ra ~= rb then return ra < rb end
        return recipeValue(a) > recipeValue(b)
    end)

    for _, name in ipairs(names) do
        local n = bestCount(eggs, name, avail)
        if n >= 1 then
            local need, steps = tryBuild(eggs, name, n)
            return {
                name = name, count = n, steps = steps,
                need = need, buy = math.max(0, need - tickets),
            }
        end
    end

    for _, name in ipairs(names) do
        if bestCount(eggs, name, math.huge) >= 1 then
            return nil, "Не хватает тикетов (и докупить нельзя)"
        end
    end
    return nil, "Не хватает ресурсов ни на один рецепт"
end

-- сколько тикетов нужно, чтобы ускорить текущий заказ
local function orderTicketsNeeded(st)
    local r = BlenderRecipes.Get(st.Recipe)
    if not r then return 0 end
    local playtime = ClientStatCache:Get("PlaytimeAtLoad")
    local loadTime = ClientStatCache:Get("LoadTime")
    if not playtime or not loadTime or not OsTime then return nil end
    local offline = ClientStatCache:Get("OfflineProgressTime") or 0
    local elapsed = playtime + (OsTime() - loadTime) + offline - st.StartTime
    local count = st.Count
    local progress = math.clamp(elapsed / (count * r.Time), 0, 1)
    local per = r.AutoCompletePerTicket or 1
    local done = math.floor(math.floor(progress * count) / per)
    return math.ceil((count - done * per) / per)
end

-- ускорить тикетами и забрать
local function finishOrder(st)
    local need = orderTicketsNeeded(st)
    if need == nil then return false, "нет данных о времени заказа" end
    if need > 0 then
        if getTickets() < need then
            return false, "на текущий заказ не хватает тикетов (нужно " .. need .. ")"
        end
        local ok, e = pcall(Events.ClientCall, "BlenderCommand", "SpeedUpOrder")
        if not ok then return false, tostring(e) end
        task.wait(0.5)
    end
    pcall(Events.ClientCall, "BlenderCommand", "StopOrder")
    pcall(function() ClientStatCache:Set("BlenderState", nil) end)
    return true
end

-- один заказ в блендере
local function runStep(name, count)
    local before = eggCountOf(name)
    log(string.format("Блендер: заказ %s x%s", name, fmt(count)))
    local ok, state = pcall(Events.ClientCall, "BlenderCommand", "PlaceOrder", {
        Recipe = name, Count = count,
    })
    if not ok or not state then
        return false, "блендер отклонил заказ " .. name .. " (проверь, что ты рядом с ним)"
    end
    pcall(function() ClientStatCache:Set("BlenderState", state) end)
    task.wait(0.5)

    local st = ClientStatCache:Get("BlenderState")
    if st then
        local ok2, msg = finishOrder(st)
        if not ok2 then return false, msg end
    end

    waitFor(function() return eggCountOf(name) > before end, 4)
    local got = eggCountOf(name) - before
    if got <= 0 then return false, "предметы не пришли: " .. name end
    return true, got
end

-- весь план: докупка тикетов, докрафт ингредиентов, затем сам рецепт
local function runPlan(plan)
    if plan.buy > 0 then
        log("Блендер: докупаю тикеты x" .. fmt(plan.buy))
        if not buyTickets(plan.buy) then return false, "не удалось купить тикеты" end
    end
    local got = 0
    for i, s in ipairs(plan.steps) do
        local ok, res = runStep(s.name, s.count)
        if not ok then return false, res end
        if i == #plan.steps then got = res end
    end
    return true, got
end

-- Применить воск по кругу на все беквипы, пока не кончится
local function autoUseWax(key)
    local bees = getBeesWithBeequips()
    local used, dead = 0, {}
    local progress = true
    while progress and eggCountOf(key) > 0 do
        progress = false
        for _, bee in ipairs(bees) do
            if eggCountOf(key) <= 0 then break end
            local id = bee.x .. "," .. bee.y
            if not dead[id] and hasBeequip(bee.x, bee.y) then
                if useEggAt(bee.x, bee.y, key) then
                    used += 1
                    progress = true
                    task.wait(0.25)
                else
                    dead[id] = true
                end
            end
        end
    end
    return used
end

local function doBlender(c)
    local b = c.Blender
    if not b.Enabled then return end
    if not BlenderRecipes then log("Блендер: модуль BlenderRecipes не найден") return end

    local cap = toAmount(b.BuyTicketsUpTo, TICKET_LIMIT)
    local maxRounds = math.max(1, toAmount(b.MaxRounds, 1000))
    local rounds, boughtTotal = 0, 0

    repeat
        rounds += 1

        local st = ClientStatCache:Get("BlenderState")
        if st then
            local ok, msg = finishOrder(st)
            if not ok then log("Блендер: ❌", msg) return end
        end

        local plan, err = makePlan(cap - boughtTotal, b.Priority)
        if not plan then
            log(rounds == 1 and ("Блендер: ❌ " .. tostring(err)) or ("Блендер: готово — " .. tostring(err)))
            return
        end

        local ok, res = runPlan(plan)
        if not ok then log("Блендер: ❌", res) return end
        boughtTotal += plan.buy

        local msg = string.format("Блендер: ✓ %s x%s", plan.name, fmt(res))
        if b.AutoWax and AUTO_WAX[plan.name] then
            msg ..= string.format(" • воск применён: %d", autoUseWax(plan.name))
        end
        log(msg)
        task.wait(0.5)
    until not b.Repeat or rounds >= maxRounds
end

----------------------------------------------------------------
-- Lag: фантомный беквип с оффсетом math.huge (только на клиенте, сервер не трогаем)
----------------------------------------------------------------
-- если скрипт перезапущен - снимаем наш старый хук
if env.__EggBuyerOldGet then
    pcall(function() ClientStatCache.Get = env.__EggBuyerOldGet end)
    env.__EggBuyerOldGet = nil
end

local lagPhantoms = {}
local lagCount = 0

local function installPhantomHook()
    if env.__EggBuyerOldGet then return end
    local old = ClientStatCache.Get
    env.__EggBuyerOldGet = old
    ClientStatCache.Get = function(...)
        local stats = old(...)
        -- подмешиваем только в полный объект статов (без path)
        local hasPath = select("#", ...) >= 2 and (select(2, ...)) ~= nil
        if not hasPath and #lagPhantoms > 0 then
            pcall(function()
                local bq = stats and stats.Beequips
                local storage = bq and bq.Storage
                if type(storage) ~= "table" then return end
                if storage[#storage] ~= lagPhantoms[#lagPhantoms] then
                    for _, ph in ipairs(lagPhantoms) do
                        local present = false
                        for _, v in ipairs(storage) do
                            if v == ph then present = true break end
                        end
                        if not present then table.insert(storage, ph) end
                    end
                end
                if type(bq.StorageSize) ~= "number" or bq.StorageSize < #storage then
                    bq.StorageSize = #storage
                end
            end)
        end
        return stats
    end
end

local function doLag(c)
    if not c.Lag then return end
    if not (BeequipFile and BeequipTypes and WaxTypes) then log("Лаг: не найдены модули беквипов/воска") return end

    local name = tostring(c.LagBeequip or "Kazoo")
    local def = BeequipTypes.Get(name)
    if not def then log("Лаг: неизвестный беквип", name) return end

    local waxId = 1
    for id, data in pairs(WaxTypes.TypeByID) do
        if string.find(string.lower(tostring(data.Name or "")), "hard", 1, true) then waxId = id break end
    end

    lagCount += 1
    local rng = Random.new()
    local raw = {
        T = name, Q = 1, S = rng:NextInteger(1, 2199023255551),
        IDs = {player.UserId, 700000 + lagCount, rng:NextInteger(1, 9007199254740991), os.time()},
        UC = 0, RC = 0, TC = 0,
        W = {{waxId, true, math.huge}}, -- оффсет math.huge
    }
    setmetatable(raw, BeequipFile)
    raw.GetTypeDef = function() return def end
    raw.GenerateModifiers = function()
        local ok, m, h, a = pcall(BeequipFile.GenerateModifiers, raw)
        if ok then return m, h, a end
        return {}, {}, {}
    end

    phantomSet[raw] = true
    table.insert(lagPhantoms, raw)
    installPhantomHook()
    log("Лаг: фантомный беквип создан в хранилище")

    -- обновить меню и попытаться открыть хранилище (названия методов - предположение)
    pcall(function()
        local mgr = require(ReplicatedStorage.Gui.BeequipMenus.BeequipMenuManager)
        mgr.UpdateAll()
        local menu = mgr.GetByName and mgr.GetByName("Storage")
        if menu then
            for _, fn in ipairs({"Open", "Show", "Toggle"}) do
                if type(menu[fn]) == "function" then
                    pcall(menu[fn], menu)
                    break
                end
            end
        end
    end)
end

