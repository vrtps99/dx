local function runOnce()
    CFG = merge(Defaults, env.Config) -- перечитываем конфиг каждый цикл
    CFG.Wax.Type = WAX_BY_LOWER[tostring(CFG.Wax.Type):lower()] or CFG.Wax.Type -- регистр не важен
    local steps = {
        {"Treats", doTreats},
        {"Tickets", doTickets},
        {"EvictionBuy", doEvictionBuy},
        {"EvictionUse", doEvictionUse},
        {"DiscardStickers", doDiscardStickers},
        {"EquipBeequips", doEquipBeequips},
        {"Wax", doWax},
        {"DiscardBeequips", doDiscardBeequips},
        {"Blender", doBlender},
        {"Lag", doLag}, -- всегда последним: может подвесить клиент
    }
    for _, s in ipairs(steps) do
        local ok, err = pcall(s[2], CFG)
        if not ok then log("Ошибка в " .. s[1] .. ":", tostring(err)) end
    end
end

-- повторный запуск скрипта останавливает предыдущий цикл
local token = {}
env.__EggBuyerToken = token

task.spawn(function()
    runOnce()
    while CFG.Loop and env.__EggBuyerToken == token do
        task.wait(math.max(5, tonumber(CFG.LoopDelay) or 0))
        if env.__EggBuyerToken ~= token then break end
        runOnce()
    end
    log("Готово")
end)
