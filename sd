-- true / "true" / "yes" / "on" / "1" / 1 -> true, всё остальное -> false
local function toBool(v)
    if type(v) == "boolean" then return v end
    if type(v) == "number" then return v ~= 0 end
    if type(v) == "string" then
        local s = (v:lower():gsub("%s+", ""))
        return s == "true" or s == "yes" or s == "on" or s == "1" or s == "да"
    end
    return false
end

-- Глубокое слияние: словари сливаются, массивы (Priority) заменяются целиком.
-- Пропущенные ключи берутся из defaults; у булевых полей значение приводится к true/false.
local function merge(def, usr)
    local out = {}
    for k, v in pairs(def) do
        local u = type(usr) == "table" and usr[k] or nil
        if type(v) == "table" and #v == 0 then
            out[k] = merge(v, u)
        elseif u ~= nil then
            if type(v) == "boolean" then out[k] = toBool(u) else out[k] = u end
        else
            out[k] = v
        end
    end
    return out
end

local CFG = merge(Defaults, env.Config)

local function log(...)
