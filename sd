----------------------------------------------------------------
-- Общие функции
----------------------------------------------------------------
local function fmt(n)
    local str = string.format("%.0f", math.floor(n))
    local out = str:reverse():gsub("(%d%d%d)", "%1 "):reverse()
    return (out:gsub("^%s+", ""))
end

local function eggCountOf(key)
    local stats = ClientStatCache:Get()
    return (stats and stats.Eggs and stats.Eggs[key]) or 0
end

local function getHoney()
    local stats = ClientStatCache:Get()
    return (stats and stats.Honey) or 0
end

local function purchasesOf(key)
    local stats = ClientStatCache:Get()
    local t = stats and stats.Totals and stats.Totals.Purchases and stats.Totals.Purchases.Eggs
    return (t and t[key]) or 0
end

-- ждать, пока fn() станет true (до timeout секунд)
local function waitFor(fn, timeout)
    local t0 = os.clock()
    while not fn() and os.clock() - t0 < timeout do task.wait(0.1) end
    return fn()
end

-- число / "all" / "max" -> число (0 если не задано или некорректно)
local function toAmount(v, total)
    if type(v) == "string" then
        local s = (v:lower():gsub("%s+", ""))
        if (s == "all" or s == "max" or s == "все") then
            return total or 0
        end
        v = tonumber(s)
    end
    if type(v) ~= "number" or v <= 0 then return 0 end
    v = math.floor(v)
    if total then v = math.min(v, total) end
    return v
end

-- Занятые слоты улья и число открытых слотов
local function getHive()
    local bees, unlocked = {}, 0
    local hcValue = player:FindFirstChild("Honeycomb")
    local hc = hcValue and hcValue.Value
    if not hc then return bees, unlocked end

    local data = ClientStatCache:Get("Honeycomb") or {}
    for x = 1, 5 do
        for y = 1, 10 do
            local cell = hc.Cells:FindFirstChild("C" .. x .. "," .. y)
            if cell then
                local lockedVal = cell:FindFirstChild("CellLocked")
                if not (lockedVal and lockedVal.Value) then
                    unlocked += 1
                    local col = data["x" .. x]
                    if col and col["y" .. y] then
                        table.insert(bees, {x = x, y = y})
                    end
                end
            end
        end
    end
    return bees, unlocked
end

-- Применить яйцо/воск на ячейку. true при успехе
local function useEggAt(x, y, eggType)
    local ok, eggs, success, honeycomb, discovered, uses = pcall(function()
        return Events.ClientCall("ConstructHiveCellFromEgg", x, y, eggType, 1, false, nil)
    end)
    if not ok or not success then return false end

    pcall(function()
        ClientStatCache:Set({"Eggs", eggType}, eggs)
        ClientStatCache:Set("DiscoveredBees", discovered)
        ClientStatCache:Set("Honeycomb", honeycomb)
        ClientStatCache:Set({"Totals", "EggUses"}, uses)
    end)
    return true
end

local function beeFileAt(x, y)
    local data = ClientStatCache:Get("Honeycomb")
    local col = data and data["x" .. x]
    return col and col["y" .. y]
end

local function hasBeequip(x, y)
    if not BeeStats then return false end
    local file = beeFileAt(x, y)
    if not file then return false end
    local ok, bq = pcall(BeeStats.GetBeequip, file)
    return ok and bq ~= nil
end

local function getBeesWithBeequips()
    local out = {}
    for _, b in ipairs((getHive())) do
        if hasBeequip(b.x, b.y) then table.insert(out, b) end
    end
    return out
end

----------------------------------------------------------------
-- Евикты
----------------------------------------------------------------
local function purchaseEviction(amount)
    EggTypes.Get(EGG).Hidden = false
    Events.ClientCall("ItemPackageEvent", "Purchase", {
        Category = "Eggs", Type = EGG, Amount = amount,
    })
end

-- купить максимум, на что хватает мёда: пачками по убыванию, пока покупка проходит
local function buyAllEvictions()
    local total = 0
    for _, step in ipairs({100000, 10000, 1000, 100, 10, 1}) do
        while true do
            local before = eggCountOf(EGG)
            local ok = pcall(purchaseEviction, step)
            if not ok then break end
            waitFor(function() return eggCountOf(EGG) > before end, 2)
            local got = eggCountOf(EGG) - before
            if got <= 0 then break end
            total += got
        end
    end
    return total
end

local function isAllWord(v)
    return type(v) == "string" and (({all = true, max = true, ["все"] = true})[(v:lower():gsub("%s+", ""))] or false)
end

local function doEvictionBuy(c)
    if isAllWord(c.Eviction.Buy) then
        log("Евикты: куплено (всё на мёд)", buyAllEvictions())
        return
    end
    local n = toAmount(c.Eviction.Buy)
    if n <= 0 then return end
    local before = eggCountOf(EGG)
    local ok, e = pcall(purchaseEviction, n)
    if not ok then log("Евикты: ошибка покупки:", e) return end
    waitFor(function() return eggCountOf(EGG) > before end, 4)
    log("Евикты: куплено", eggCountOf(EGG) - before)
end

local function doEvictionUse(c)
    local bees = getHive()
    local amount = toAmount(c.Eviction.Use, #bees)
    if amount <= 0 then return end

    local owned = eggCountOf(EGG)
    if owned < amount and c.Eviction.AutoBuyMissing then
        pcall(purchaseEviction, amount - owned)
        waitFor(function() return eggCountOf(EGG) >= amount end, 4)
        owned = eggCountOf(EGG)
    end
    amount = math.min(amount, owned)
    if amount <= 0 then log("Евикты: нет евиктов для использования") return end

    local done = 0
    for i = 1, amount do
        local slot = bees[i]
        if not useEggAt(slot.x, slot.y, EGG) then
            log(string.format("Евикты: остановлено на %d/%d", done, amount))
            return
        end
        done += 1
        task.wait(0.2)
    end
    log("Евикты: использовано", done)
end

----------------------------------------------------------------
-- Печеньки
----------------------------------------------------------------
-- цена одной печеньки: 100 + 100 * (уже куплено), максимум 10000
local function treatPrice(bought)
    return math.min(100 + 100 * bought, 10000)
end

local function maxTreats(honey, bought)
    local total, k = 0, 0
    while true do
        local c = treatPrice(bought + k)
        if total + c > honey then return k end
        total += c
        k += 1
        if c >= 10000 then
            return k + math.floor((honey - total) / 10000)
        end
    end
end

local function doTreats(c)
    local cap = maxTreats(getHoney(), purchasesOf("Treat"))
    local n = toAmount(c.Treats.Buy, cap)
    if n <= 0 then
        if toAmount(c.Treats.Buy, math.huge) > 0 then log("Печеньки: не хватает мёда") end
        return
    end
    local before = eggCountOf("Treat")
    local ok, e = pcall(function()
        Events.ClientCall("ItemPackageEvent", "Purchase", {
            Category = "Eggs", Type = "Treat", Amount = n,
        })
    end)
    if not ok then log("Печеньки: ошибка:", e) return end
    waitFor(function() return eggCountOf("Treat") > before end, 3)
    log("Печеньки: куплено", eggCountOf("Treat") - before)
end

----------------------------------------------------------------
-- Тикеты
----------------------------------------------------------------
local TICKET_LIMIT = 100000

local function ticketPrice(k)
    if k > 50000 then
        return math.floor((k - 50000) ^ 1.85) * 10000000 + 100000000000
    end
    return math.floor((k - 1) ^ (k < 500 and 1.2 or 1.7)) * 1000 + 100000
end

local function getTickets() return eggCountOf("Ticket") end
local function getTicketPurchases() return purchasesOf("Ticket") end

-- сколько тикетов (не больше want) можно купить на мёд
local function affordableTickets(honey, bought, want)
    local total, count = 0, 0
    while count < want and bought + count < TICKET_LIMIT do
        local price = ticketPrice(1 + bought + count)
        if total + price > honey then break end
        total += price
        count += 1
    end
    return count, total
end

local function buyTickets(n)
    local before = getTickets()
    local ok, e = pcall(function()
        Events.ClientCall("ItemPackageEvent", "Purchase", {
            Category = "Eggs", Type = "Ticket", Amount = n,
        })
    end)
    if not ok then return false, tostring(e) end
    return waitFor(function() return getTickets() > before end, 3)
end

local function doTickets(c)
    local bought = getTicketPurchases()
    local cap = affordableTickets(getHoney(), bought, TICKET_LIMIT - bought)
    local n = toAmount(c.Tickets.Buy, cap)
    if n <= 0 then
        if toAmount(c.Tickets.Buy, math.huge) > 0 then log("Тикеты: не хватает мёда") end
        return
    end
    local ok = buyTickets(n)
    log(ok and ("Тикеты: теперь " .. fmt(getTickets())) or "Тикеты: покупка не прошла")
end

----------------------------------------------------------------
-- Хелперы беквипов: экип / воск / скипидар
----------------------------------------------------------------
local MAX_WAXES = (BeequipFile and BeequipFile.MAX_WAXES) or 5
local VALID_WAX = {SoftWax = true, HardWax = true, CausticWax = true, SwirledWax = true, Turpentine = true}
local WAX_BY_LOWER = {}
for k in pairs(VALID_WAX) do WAX_BY_LOWER[k:lower()] = k end

-- сколько ваксов уже на беквипе пчелы в слоте x,y
local function waxCountAt(x, y)
    if not BeeStats then return 0 end
    local file = beeFileAt(x, y)
    if not file then return 0 end
    local ok, bq = pcall(BeeStats.GetBeequip, file)
    if not ok or not bq then return 0 end
    local ok2, h = pcall(function() return bq:GetWaxHistory() end)
    if ok2 and type(h) == "table" then return #h end
    return type(bq.W) == "table" and #bq.W or 0
end

-- Вакс на пчеле: если ваксов уже MAX и включён useTurp - сначала скипидар.
-- Возвращает сколько ваксов реально применено.
local function waxBee(x, y, key, times, useTurp)
    local used = 0
    if useTurp and key ~= "Turpentine" and waxCountAt(x, y) >= MAX_WAXES then
        if eggCountOf("Turpentine") > 0 and useEggAt(x, y, "Turpentine") then
            task.wait(0.25)
        else
            return 0
        end
    end
    for _ = 1, times do
        if eggCountOf(key) <= 0 then break end
        if not hasBeequip(x, y) then break end -- беквип пропал (например, сломался)
        if key ~= "Turpentine" and waxCountAt(x, y) >= MAX_WAXES then break end
        if useEggAt(x, y, key) then
            used += 1
        else
            break
        end
        task.wait(0.25)
    end
    return used
end

-- пчёлы без беквипа
local function freeBeeSlots()
    local out = {}
    for _, b in ipairs((getHive())) do
        if not hasBeequip(b.x, b.y) then table.insert(out, b) end
    end
    return out
end

local function beequipCall(action, file, extra)
    local data = {BeequipIDs = file.IDs}
    if extra then for k, v in pairs(extra) do data[k] = v end end
    local ok, res = pcall(Events.ClientCall, "BeequipEvent", action, data)
    return ok and res ~= false
end

-- надеть беквип на пчелу (сначала в кейс, потом Equip с координатами слота)
local function equipFile(file, slot)
    beequipCall("MoveToCase", file) -- если уже в кейсе - ошибка не страшна
    task.wait(0.2)
    beequipCall("Equip", file, {X = slot.x, Y = slot.y})
    return waitFor(function() return hasBeequip(slot.x, slot.y) end, 3)
end

local function unequipFile(file, slot)
    beequipCall("Unequip", file)
    return waitFor(function() return not hasBeequip(slot.x, slot.y) end, 3)
end

----------------------------------------------------------------
-- Дискард стикеров / беквипов
----------------------------------------------------------------
local RARITY_ORDER = {Common = 1, Rare = 2, Epic = 3, Legendary = 4}

-- "Common"/"Rare"/... (без учёта регистра) -> номер; "all" -> allValue
local function rarityOf(v, allValue)
    local s = (tostring(v or ""):lower():gsub("%s+", ""))
    if s == "all" then return allValue end
    for name, n in pairs(RARITY_ORDER) do
        if name:lower() == s then return n end
    end
    return 1
end

local function collectStickers(fromBook)
    local out = {}
    if not StickerFile then return out end
    local stats = ClientStatCache:Get()
    local data = stats and stats.Stickers
    if not data then return out end

    local function add(list)
        for _, v in ipairs(list or {}) do
            local ok, file = pcall(StickerFile.FromData, v)
            if ok and file then
                local ok2, good = pcall(function()
                    local def = file:GetTypeDef()
                    return def and not def.System and file:GetCosmeticType() == "Sticker"
                end)
                if ok2 and good then table.insert(out, file) end
            end
        end
    end
    add(data.Inbox)
    if fromBook then add(data.Book) end
    return out
end

local function collectBeequips(fromStorage, rarityLimit, includePermanent)
    local out = {}
    if not BeequipFile then return out end
    local stats = ClientStatCache:Get()
    local data = stats and stats.Beequips
    if not data then return out end

    local function add(list)
        for _, v in ipairs(list or {}) do
            local ok, file = pcall(BeequipFile.FromData, v)
            if ok and file and not phantomSet[v] then
                local ok2, good = pcall(function()
                    local def = file:GetTypeDef()
                    if not def or (def.Permanent and not includePermanent) then return false end
                    local r = RARITY_ORDER[def.Rarity or "Common"] or 99
                    return r <= rarityLimit
                end)
                if ok2 and good then table.insert(out, file) end
            end
        end
    end
    add(data.Inbox)
    if fromStorage then add(data.Storage) end
    return out
end

local function discardLoop(items, amount, exec, what)
    local done = 0
    for i = 1, amount do
        if not exec(items[i]) then
            log(string.format("%s: остановлено на %d/%d", what, done, amount))
            return
        end
        done += 1
        task.wait(0.15)
    end
    log(what .. ": удалено", done)
end

local function doDiscardStickers(c)
    if toAmount(c.DiscardStickers.Amount, math.huge) <= 0 then return end
    local items = collectStickers(c.DiscardStickers.FromBook)
    local amount = toAmount(c.DiscardStickers.Amount, #items)
    if amount <= 0 then log("Стикеры: нечего удалять") return end
    discardLoop(items, amount, function(file)
        local ok, res = pcall(Events.ClientCall, "StickerDiscard", file, false)
        return ok and res ~= false
    end, "Стикеры")
end

local function doDiscardBeequips(c)
    if toAmount(c.DiscardBeequips.Amount, math.huge) <= 0 then return end
    local limit = math.min(rarityOf(c.DiscardBeequips.MaxRarity, 3), 3) -- Legendary никогда не удаляем
    local items = collectBeequips(c.DiscardBeequips.FromStorage, limit)
    local amount = toAmount(c.DiscardBeequips.Amount, #items)
    if amount <= 0 then log("Беквипы: нечего удалять") return end

    local key = c.Wax.Type
    local times = toAmount(c.Wax.Times, 999)

    -- без вакса: обычное удаление
    if times <= 0 or not VALID_WAX[key] then
        discardLoop(items, amount, function(file)
            local ok, res = pcall(Events.ClientCall, "BeequipEvent", "Discard", {BeequipIDs = file.IDs})
            return ok and res ~= false
        end, "Беквипы")
        return
    end

    -- с ваксом: надеть -> (скипидар) -> вакс -> снять -> удалить
    local slots = freeBeeSlots()
    if #slots == 0 then log("Беквипы: нет свободной пчёлы (без беквипа) для вакса перед удалением") return end
    local slot = slots[1]
    local done, waxUsed = 0, 0

    for i = 1, amount do
        local file = items[i]
        if not equipFile(file, slot) then
            log(string.format("Беквипы: не удалось надеть %d/%d, остановлено", i, amount))
            break
        end

        waxUsed += waxBee(slot.x, slot.y, key, times, c.Wax.Turpentine)

        if hasBeequip(slot.x, slot.y) then
            if not unequipFile(file, slot) then
                log("Беквипы: не удалось снять, остановлено")
                break
            end
            local ok = beequipCall("Discard", file)
            if not ok then
                beequipCall("Store", file) -- запасной путь: в хранилище, потом удалить
                ok = beequipCall("Discard", file)
            end
            if not ok then
                log("Беквипы: не удалось удалить, остановлено")
                break
            end
        end -- иначе беквип сломался воском сам
        done += 1
        task.wait(0.15)
    end
    log(string.format("Беквипы: обработано %d (ваксов применено %d)", done, waxUsed))
end

local function doEquipBeequips(c)
    local e = c.EquipBeequips
    if toAmount(e.Amount, math.huge) <= 0 then return end
    local limit = rarityOf(e.MaxRarity, 4)
    local items = collectBeequips(e.FromStorage, limit, true)
    local slots = freeBeeSlots()
    local amount = toAmount(e.Amount, math.min(#items, #slots))
    if amount <= 0 then log("Экип: нет беквипов или свободных пчёл") return end

    local done = 0
    for i = 1, amount do
        if equipFile(items[i], slots[i]) then
            done += 1
        else
            log(string.format("Экип: не удалось надеть на слот %d,%d", slots[i].x, slots[i].y))
        end
        task.wait(0.2)
    end
    log("Экип: надето", done)
end

